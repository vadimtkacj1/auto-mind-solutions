# Docker Environment Variables
# Copy this to .env for Docker deployment

# Application
NODE_ENV=production
PORT=80
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://auto-mind.solutions
NEXT_PUBLIC_SITE_NAME="AUTO MIND STUDIO"

# API Configuration
NEXT_PUBLIC_API_URL=https://auto-mind.solutions

# Email Configuration (for contact form)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_TO=hello@auto-mind.solutions

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Security
REVALIDATE_SECRET=your-super-secret-revalidation-token

# Database (if needed)
# DATABASE_URL=postgresql://user:password@host:port/database

# Redis (if needed)
# REDIS_URL=redis://localhost:6379

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_COOKIE_CONSENT=true
